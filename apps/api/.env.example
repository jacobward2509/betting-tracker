# Development API env
# Replace with your DEV Supabase Postgres connection string
DATABASE_URL="postgresql://postgres:<password>@<your-dev-host>:5432/postgres"

# API server port
PORT=3000

# Comma-separated origins allowed to call the API from browser
# For local Vite default:
CORS_ORIGIN="http://localhost:5173"

# TheSportsDB API key — "3" is TheSportsDB's published public free/test key
# that works without any account or registration (see
# https://www.thesportsdb.com/free_sports_api). The free tier caps fixtures
# at 3 events/call and rosters/team-lists at 10 results/call with no working
# pagination, and rate-limits at 30 requests/minute. Set this to a personal
# Premium ($9/mo, 3000 result cap, 100 req/min) or Business ($20/mo, no
# result cap, 120 req/min) key to lift those caps — see
# apps/api/src/services/thesportsdb.ts for the full tier comparison. Used by
# the daily fixtures cache refresh (scripts/refresh-fixtures.ts), the
# one-off bulk player backfill (scripts/backfill-all-players.ts), and the
# on-demand player-roster reconciliation in server.ts.
THESPORTSDB_API_KEY="3"

# Optional: raises the shared rate limiter's requests-per-minute budget to
# match a paid TheSportsDB tier (Premium: 100, Business: 120). Defaults to
# 25 (a safety margin under the free tier's 30/minute) if unset.
THESPORTSDB_RATE_LIMIT_PER_MINUTE=25

