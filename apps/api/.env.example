# Development API env
# Replace with your DEV Supabase Postgres connection string
DATABASE_URL="postgresql://postgres:<password>@<your-dev-host>:5432/postgres"

# API server port
PORT=3000

# Comma-separated origins allowed to call the API from browser
# For local Vite default:
CORS_ORIGIN="http://localhost:5173"

# TheSportsDB free/test API key — "3" is TheSportsDB's published public key
# that works without any account or registration (see
# https://www.thesportsdb.com/free_sports_api). Used by the daily fixtures
# cache refresh (scripts/refresh-fixtures.ts) that powers the animated
# fixtures banner. Upgrade to a personal Patreon-tier key here if needed.
THESPORTSDB_API_KEY="3"
