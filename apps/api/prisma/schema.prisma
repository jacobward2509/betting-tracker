generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Bet {
  id               String    @id @default(uuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixture          String
  selection        String
  bookmaker        Bookmaker @default(Bet365)
  stakeType        StakeType @default(NORMAL)
  betType          String    @default("Player Prop")
  playerPropMarket String?
  stake            Decimal
  normalStake      Decimal?
  odds             Decimal
  potentialReturn  Decimal
  result           BetResult @default(OPEN)
  cashOutValue     Decimal?
  profit           Decimal?
  placedAt         DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // New structured-market fields (all optional/nullable, additive only —
  // existing rows and the legacy fixture/selection/betType/playerPropMarket
  // string columns above are left completely untouched so no historical bet
  // data, for any user, is at risk when these are populated going forward).
  marketId        Int?
  market          Market?          @relation(fields: [marketId], references: [id], onDelete: SetNull)
  selectionId     Int?
  marketSelection MarketSelection? @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  lineValue       Decimal?
  fixtureId       String?
  fixtureRef      Fixture?         @relation(fields: [fixtureId], references: [id], onDelete: SetNull)
  playerId        String?
  playerRef       Player?          @relation(fields: [playerId], references: [id], onDelete: SetNull)

  // Per-leg detail for multi-leg bet types (Accumulator, Bet Builder, Cross
  // Match Bet Builder). Purely additive — legs is empty for every other bet
  // type and for any historical Accumulator/Bet Builder rows logged before
  // this feature existed, so those keep displaying via the flat
  // fixture/selection strings above exactly as they do today.
  legs BetLeg[]

  @@index([userId])
  @@index([marketId])
  @@index([fixtureId])
  @@index([playerId])
}

// One leg of a multi-leg bet (Accumulator / Bet Builder / Cross Match Bet
// Builder). Always sourced from the same structured catalog used for
// single-fixture bets (Fixture, Market, MarketSelection, MarketLine,
// Player) — there is deliberately no manual/free-text fallback here, per
// the plan to phase manual fixture/selection entry out entirely.
model BetLeg {
  id    String @id @default(uuid())
  betId String
  bet   Bet    @relation(fields: [betId], references: [id], onDelete: Cascade)
  order Int    @default(0)

  fixtureId  String
  fixtureRef Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  marketId        Int
  market          Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  selectionId     Int
  marketSelection MarketSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  lineValue       Decimal?

  playerId  String?
  playerRef Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  // Generated the same way getGeneratedDescription() builds a single bet's
  // selection string, so existing display/CSV code paths that only know how
  // to read a flat string keep working for the per-leg breakdown too.
  description String

  createdAt DateTime @default(now())

  @@index([betId])
  @@index([fixtureId])
  @@index([marketId])
  @@index([playerId])
}

model User {
  id           String          @id @default(uuid())
  name         String          @default("User")
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  bets         Bet[]
  sessions     Session[]
  bookmakers   UserBookmaker[]
  preferences  UserPreference?
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserBookmaker {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmaker Bookmaker
  createdAt DateTime  @default(now())

  @@unique([userId, bookmaker])
  @@index([userId])
}

model UserPreference {
  id               Int        @id @default(autoincrement())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultBookmaker Bookmaker?
  defaultBetType   String?
  defaultStake     Decimal?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Bookmakers {
  id         Int       @id @default(autoincrement())
  bookmakers Bookmaker
}

model Fixture {
  id                 String   @id @default(uuid())
  sportsDbEventId    String   @unique
  league             League
  homeTeam           String
  awayTeam           String
  homeTeamSportsDbId String?
  awayTeamSportsDbId String?
  kickoffAt          DateTime
  venue              String?
  // true once this fixture's date is in the past — past-dated fixtures are
  // cached permanently (never pruned by the daily refresh job) so
  // retrospective bet logging keeps working; future fixtures (today..+7
  // days) remain subject to the existing daily prune/refresh cycle.
  isHistorical       Boolean  @default(false)
  fetchedAt          DateTime @default(now())
  createdAt          DateTime @default(now())

  bets Bet[]
  legs BetLeg[]

  @@index([kickoffAt])
}

// Legacy flat lookup tables. Superseded by Market/MarketSelection/MarketLine
// below, but intentionally NOT dropped — existing Bet rows (for every user,
// including historical data that must never be lost) store their betType /
// playerPropMarket as plain strings with no FK into these tables, so keeping
// them around costs nothing and preserves any code path that still reads
// them for backward compatibility.
model BetTypes {
  id       Int    @id @default(autoincrement())
  betTypes String @unique
}

model PlayerPropMarkets {
  id      Int    @id @default(autoincrement())
  markets String @unique
}

// Structured market catalog (replaces manually-curated BetTypes /
// PlayerPropMarkets for the Add/Edit Bet UI going forward).
model Market {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  category       MarketCategory
  requiresPlayer Boolean        @default(false)
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())

  selections MarketSelection[]
  lines      MarketLine[]
  bets       Bet[]
  legs       BetLeg[]
}

model MarketSelection {
  id        Int    @id @default(autoincrement())
  marketId  Int
  market    Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int    @default(0)

  bets Bet[]
  legs BetLeg[]

  @@unique([marketId, label])
}

model MarketLine {
  id        Int     @id @default(autoincrement())
  marketId  Int
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  value     Decimal
  sortOrder Int     @default(0)

  @@unique([marketId, value])
}

// Cached player roster data (per team, sourced from TheSportsDB's
// lookup_all_players.php), refreshed alongside the fixtures cache so the Add
// Bet player dropdown can be populated from the two teams in the selected
// fixture without ever calling out to TheSportsDB from a request handler.
model Player {
  id             String   @id @default(uuid())
  sportsDbId     String   @unique
  teamSportsDbId String
  teamName       String
  name           String
  position       String?
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  bets Bet[]
  legs BetLeg[]

  @@index([teamSportsDbId])
}

// Curated, industry-led list of UK-facing bookmakers (rebuilt from scratch —
// see migration 20260903000000_rebuild_bookmaker_catalog). Every member is
// intentionally a plain no-space identifier so no @map(...) is required
// anywhere in this enum; apps/web/src/utils/bookmaker.ts's
// formatBookmakerLabel() is solely responsible for inserting spaces/casing
// for display (e.g. PaddyPower -> "Paddy Power", EightEightEightSport ->
// "888sport").
enum Bookmaker {
  Bet365
  Betfair
  BetUK
  Ladbrokes
  PaddyPower
  SkyBet
  WilliamHill
  Coral
  BetVictor
  Betfred
  EightEightEightSport
  Unibet
  LiveScoreBet
  BoyleSports
  VirginBet
  Betway
  ThirtyTwoRed
  GrosvenorSport
  QuinnBet
  Spreadex
  MansionBet
  StarSports
  CasumoBet
}

enum StakeType {
  NORMAL
  FREE
  NORMAL_PLUS_FREE
}

enum BetResult {
  OPEN
  WON
  LOST
  VOID
}

enum League {
  PREMIER_LEAGUE
  CHAMPIONSHIP
  LA_LIGA
  BUNDESLIGA
  LIGUE_1
  SERIE_A
  EFL_CUP
  FA_CUP
  CHAMPIONS_LEAGUE
  EUROPA_LEAGUE
  CONFERENCE_LEAGUE
}

enum MarketCategory {
  MATCH
  PLAYER
}
